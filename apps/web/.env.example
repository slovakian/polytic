# Database
# DATABASE_URL: pooled connection, used by the app at runtime.
# DATABASE_URL_DIRECT: non-pooled/direct connection, used by Prisma CLI
#   (migrate dev/deploy, db push, studio) — pooled breaks migration locks.
DATABASE_URL=postgresql://user:password@localhost/polytik
DATABASE_URL_DIRECT=postgresql://user:password@localhost/polytik

# Auth - better-auth
# Note: APP_URL (auth base URL + CORS/trusted origin) is dynamically set by the infra package
# based on the deployment stage (prod, PR, or dev)
BETTER_AUTH_SECRET=your-secret-here
