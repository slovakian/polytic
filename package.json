{
  "name": "polytik",
  "private": true,
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "dotenv": "^17.2.2",
      "zod": "^4.1.13",
      "typescript": "^6",
      "@types/node": "^22.13.14",
      "next-themes": "^0.4.6",
      "react": "^19.2.6",
      "react-dom": "^19.2.6",
      "@prisma/client": "^7.8.0",
      "better-auth": "1.6.11",
      "@types/react": "^19.2.15",
      "@types/react-dom": "^19.2.3",
      "alchemy": "0.93.11"
    }
  },
  "type": "module",
  "scripts": {
    "dev": "bun run --filter '*' dev",
    "build": "bun run --filter '*' build",
    "check-types": "bun run --filter '*' check-types",
    "dev:web": "bun run --filter web dev",
    "db:push": "bun run --filter @polytik/db db:push",
    "db:studio": "bun run --filter @polytik/db db:studio",
    "db:generate": "bun run --filter @polytik/db db:generate",
    "db:migrate": "bun run --filter @polytik/db db:migrate",
    "deploy": "bun run --filter @polytik/infra deploy",
    "destroy": "bun run --filter @polytik/infra destroy",
    "check": "oxlint && oxfmt --write",
    "skills:publish": "git subtree push --prefix=skills/polytik-party polytik-party main"
  },
  "dependencies": {
    "@polytik/env": "workspace:*",
    "dotenv": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20251213.0",
    "@polytik/config": "workspace:*",
    "@types/node": "catalog:",
    "oxfmt": "^0.46.0",
    "oxlint": "^1.61.0",
    "typescript": "catalog:"
  },
  "packageManager": "bun@1.3.5"
}
