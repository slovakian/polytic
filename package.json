{
  "name": "polytic",
  "private": true,
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*",
      "skills"
    ],
    "catalog": {
      "zod": "^4.5.4",
      "vite": "npm:@voidzero-dev/vite-plus-core@1.1.0",
      "typescript": "^6.0.3",
      "varlock": "1.18.0",
      "next-themes": "^0.4.6",
      "sonner": "^2.0.8",
      "tailwindcss": "^4.3.3",
      "@prisma/client": "^7.10.0"
    }
  },
  "type": "module",
  "scripts": {
    "dev": "vp run -r dev",
    "build": "vp run -r build",
    "check-types": "vp run -r check-types",
    "check": "vp check && vp run -r check-types",
    "lint": "vp lint",
    "format": "vp fmt",
    "staged": "vp staged",
    "hooks:setup": "vp config",
    "dev:web": "vp run --filter web dev:bare",
    "db:push": "vp run --filter @polytic/db db:push",
    "db:studio": "vp run --filter @polytic/db db:studio",
    "db:generate": "vp run --filter @polytic/db db:generate",
    "db:migrate": "vp run --filter @polytic/db db:migrate",
    "db:deploy": "vp run --filter @polytic/db db:deploy",
    "deploy": "vp run --filter @polytic/infra deploy",
    "destroy": "vp run --filter @polytic/infra destroy",
    "env:generate": "varlock codegen --path ./apps/web/ && varlock codegen --path ./packages/db/",
    "postinstall": "varlock codegen --path ./apps/web/ && varlock codegen --path ./packages/db/"
  },
  "dependencies": {
    "zod": "catalog:"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260906.1",
    "@oxlint/plugins": "^1.89.0",
    "@polytic/config": "workspace:*",
    "@tanstack/intent": "^0.5.6",
    "@types/node": "^26.4.1",
    "oxfmt": "^0.74.0",
    "oxlint": "^1.89.0",
    "rolldown": "1.2.13",
    "typescript": "catalog:",
    "varlock": "catalog:",
    "vite": "catalog:",
    "vite-plus": "1.1.0"
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@1.1.0"
  },
  "packageManager": "bun@1.3.5",
  "intent": {
    "skills": [
      "@tanstack/ai",
      "@tanstack/react-start",
      "@tanstack/router-core",
      "@tanstack/router-plugin",
      "@tanstack/start-client-core",
      "@tanstack/start-server-core",
      "varlock"
    ],
    "exclude": [
      "@tanstack/react-start#lifecycle/*",
      "dotenv"
    ]
  }
}
